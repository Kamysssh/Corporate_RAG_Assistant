# --- OpenAI напрямую (за пределами РФ / без блокировок IP) ---
# OPENAI_API_KEY=your-openai-api-key

# --- ProxyAPI (РФ, VPS Reg.ru): https://proxyapi.ru — ключ в личном кабинете ---
OPENAI_API_PROVIDER=proxyapi
PROXYAPI_KEY=your-proxyapi-key
# URL по умолчанию: https://api.proxyapi.ru/openai/v1 (модели как у OpenAI: gpt-4o-mini, text-embedding-3-small)
# PROXYAPI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Альтернатива: тот же ключ ProxyAPI можно записать как OPENAI_API_KEY при OPENAI_API_PROVIDER=proxyapi
# OPENAI_API_KEY=

# Telegram: токен от @BotFather → в скопированном .env подставьте свой (в Git не коммитить)
# Режим 2 при запуске: python assistant_api\app.py
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather

# Telegram API (если TimedOut / нет связи с api.telegram.org в РФ):
# TELEGRAM_CONNECT_TIMEOUT=60
# TELEGRAM_READ_TIMEOUT=60
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080

# Свой endpoint (если не ProxyAPI): раскомментируйте и отключите OPENAI_API_PROVIDER=proxyapi
# OPENAI_BASE_URL=

# Таймауты HTTP (секунды), если ConnectTimeout / SSL handshake timed out
# OPENAI_CONNECT_TIMEOUT=120
# OPENAI_READ_TIMEOUT=180

# Модели
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Эмбеддинги: openai — через OpenAI/ProxyAPI; local — sentence-transformers на машине (без API).
# На VPS с ProxyAPI используйте openai.
EMBEDDINGS_BACKEND=openai

# LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Семантический кеш: порог косинусного сходства 0..1
# SEMANTIC_CACHE_THRESHOLD=0.88

# При значении 1 — полная переиндексация Chroma при старте RAGPipeline
RAG_FORCE_REINDEX=0

# --- Google Docs: база знаний (по умолчанию ссылки заданы в assistant_api/config.py) ---
# Переопределить: через запятую ID или полные ссылки. Документы: «Просмотр по ссылке».
# KNOWLEDGE_HR_GOOGLE_DOCS=
# KNOWLEDGE_POST_SALES_GOOGLE_DOCS=
# KNOWLEDGE_SALES_GOOGLE_DOCS=
#
# If Google Docs export fails with SSL errors (antivirus/VPN): try GOOGLE_DOCS_SSL_VERIFY=0
# (insecure, debugging only). Or disable HTTPS scanning in AV / turn off VPN.
# GOOGLE_DOCS_SSL_VERIFY=1
